rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 玩家公開資料：英雄榜可讀；只能改自己的，Rating 每次最多變動 64 分
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.rating >= 600 && request.resource.data.rating <= 1800;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.rating - resource.data.rating <= 64
        && resource.data.rating - request.resource.data.rating <= 64;
    }

    // 對局紀錄：只能新增自己的
    match /games/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // 對戰邀請：任何登入者都可以邀請別人；只有被邀請者能讀取／刪除
    match /invites/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.resource.data.from == request.auth.uid;
    }

    // 好友對戰房間
    match /rooms/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid
        && request.resource.data.status == 'waiting';
      allow update: if request.auth != null && (
        resource.data.red == request.auth.uid ||
        resource.data.black == request.auth.uid ||
        (resource.data.status == 'waiting' && request.resource.data.status == 'playing')
      );
    }
  }
}
